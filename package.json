{
  "name": "hackaton-ecosistema",
  "version": "1.0.0",
  "private": true,
  "description": "Ecosistema Multi-Agente para Ventas y Gestion Conversacional - Hackathon FISEI UTA 2026",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "npm --workspace=@hackaton/bot run dev",
    "dev:web": "npm --workspace=@hackaton/web run dev",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
